# --- Instagram (Meta developer dashboard -> your app -> Instagram -> API setup with Instagram login)
IG_ACCESS_TOKEN=your-long-lived-instagram-user-token
IG_USER_ID=your-instagram-professional-account-id
APP_SECRET=your-instagram-app-secret
# The token is copied into data/bot.db and refreshed automatically before it expires (60 days).
# Paste a new token here only if it ever expires; it replaces the stored one on restart.
TOKEN_AUTO_REFRESH=true
TOKEN_REFRESH_DAYS_BEFORE=10
TOKEN_CHECK_HOURS=6
# Any string you choose; paste the same value in the webhook settings in the Meta dashboard
VERIFY_TOKEN=pick-a-random-string

# --- Public pages required by Meta: /privacy and /data-deletion
# Your public HTTPS address (used in the data deletion confirmation link)
PUBLIC_URL=https://bot.yourdomain.com
# Shown on the privacy policy: your name or business, a contact email, your IG username
PRIVACY_OPERATOR=Your Name
PRIVACY_CONTACT=you@example.com
IG_USERNAME=your_instagram_username

# --- App
RULES_PATH=rules.yaml
DB_PATH=data/bot.db
# Protects /admin/stats and /admin/emails.csv  (use ?token=...)
ADMIN_TOKEN=pick-another-random-string
# true = log what would be sent instead of calling Instagram (for testing)
DRY_RUN=false
# Only in DRY_RUN: pretend the user follows you (true) or not (false)
DRY_RUN_FOLLOWS=true
GRAPH_VERSION=v23.0
